# Uygulama
NODE_ENV=development
PORT=3399

# PostgreSQL (docker-compose varsayılanları)
DATABASE_URL=postgresql://campulator:campulator@localhost:5432/campulator?schema=public

# Geliştirme kolaylığı: true iken yeni kayıtlar e-posta doğrulaması olmadan
# doğrulanmış sayılır (katkı yapabilir). PRODUCTION'DA MUTLAKA false/boş olmalı.
AUTH_AUTO_VERIFY_EMAIL=true

# JWT (Faz 1'de kullanılacak) — production'da mutlaka değiştirin
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# E-posta gönderimi (Resend). Anahtar boşken doğrulama e-postası log'a yazılır.
# Alan adı doğrulanmadan yalnızca onboarding@resend.dev adresinden ve yalnızca
# Resend hesabınızın e-postasına gönderim yapılabilir.
RESEND_API_KEY=
MAIL_FROM=Campulator <onboarding@resend.dev>
# Doğrulama bağlantısının uygulamayı açması için kullanılan şema (app.json ile aynı)
APP_LINK_SCHEME=campulator

# Harici servisler — boş bırakılırsa stub/mock davranışı devreye girer
GOOGLE_MAPS_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
APPLE_SIGN_IN_CLIENT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# Dosya depolama: local | s3 | gcs (Faz 0'da yalnızca local)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
